int melody[] = {
  NOTE_D5, NOTE_D5, NOTE_FS5, NOTE_G5, NOTE_FS5, NOTE_FS5, NOTE_G5, NOTE_A6,
  NOTE_A6, NOTE_A6, NOTE_B6, NOTE_C6, NOTE_B6, NOTE_DS6, NOTE_E6, NOTE_FS6,
  NOTE_E6, NOTE_FS6, NOTE_G6, NOTE_A7, NOTE_B7, NOTE_B7, NOTE_C7, NOTE_D7,
  NOTE_C7, NOTE_C7, NOTE_E7, NOTE_F7,
};

int durations[] = {
  400, 400, 400, 400, 400, 400, 400, 400,
  400, 400, 400, 400, 400, 400, 400, 400,
  400, 400, 400, 400, 400, 400, 400, 400,
  400, 400, 400, 400, 400, 400, 600
};

int currentNote = 0;
unsigned long previousMillis = 0;
bool musicActive = true;
const int totalNotes = 31;

void setup() {
  Serial.begin(115200);
  
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(SWITCH_PIN, INPUT_PULLUP); 

  // Désactivation immédiate si le switch est déjà activé
  if (digitalRead(SWITCH_PIN) == LOW) {
    musicActive = false;
    Serial.println("Musique desactivee au demarrage");
  }
}

void loop() {
  // Lecture du bouton pour stopper la musique
  if (digitalRead(SWITCH_PIN) == LOW && musicActive) {
    musicActive = false;
    noTone(BUZZER_PIN);
    Serial.println("Musique stoppee par l'utilisateur");
  }

  // Jouer la mélodie sans bloquer le reste
  if (musicActive && currentNote < totalNotes) {
    unsigned long currentMillis = millis();
    
    if (currentMillis - previousMillis >= (durations[currentNote] + 50)) {
      previousMillis = currentMillis;
      tone(BUZZER_PIN, melody[currentNote], durations[currentNote]);
      currentNote++;
    }
  }

  // --- CODE FUTUR (MOTEURS / CAPTEURS) ICI ---

}

const int trig_pin = D2;
const int echo_pin = D1;

bool debug = true; // Niveau 2 : variable globale de debug

void setup() {
  Serial.begin(9600);
  pinMode(trig_pin, OUTPUT);
  pinMode(echo_pin, INPUT);
}

// Niveau 1 : fonction qui mesure et retourne la distance en cm
float getDistance() {
  digitalWrite(trig_pin, LOW);
  delayMicroseconds(2);
  digitalWrite(trig_pin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trig_pin, LOW);

  long duration = pulseIn(echo_pin, HIGH);
  float distance = (duration * 0.0343) / 2;

  return distance;
}

// Niveau 1 : fonction qui affiche la distance
// Niveau 2 : affichage conditionnel selon la variable debug
void displayDistance(float distance) {
  if (debug) {
    Serial.print("Distance: ");
    Serial.print(distance);
    Serial.println(" cm");
  }
}

void loop() {
  float distance = getDistance();
  displayDistance(distance);
  delay(1000);
}
